<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/overlay_row_background"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="16dp"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/channel_number"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="64dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/channel_favorite"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_cat_favorite"
        android:visibility="gone"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/channel_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="@drawable/quality_badge"
        android:textColor="@color/accent_light"
        android:fontFamily="sans-serif-medium"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
