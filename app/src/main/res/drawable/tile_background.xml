<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Picked up for reordering favorites. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <corners android:radius="14dp" />
            <stroke android:width="4dp" android:color="@color/accent_light" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_focused" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
